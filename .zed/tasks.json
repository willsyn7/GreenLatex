[
  {
    "label": "LaTeX: Live PDF preview",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/scripts/greenlatex.py", "preview", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "no_focus"
  },
  {
    "label": "LaTeX: Build PDF",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/scripts/greenlatex.py", "build", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "reveal": "no_focus"
  },
  {
    "label": "LaTeX: Check setup",
    "command": "python3",
    "args": ["$ZED_WORKTREE_ROOT/scripts/greenlatex.py", "doctor"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
